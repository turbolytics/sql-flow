{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turbolytics.io/schemas/config.json",
  "properties": {
    "pipeline": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the pipeline."
        },
        "description": {
          "type": "string",
          "description": "Description of the pipeline."
        },
        "source": {
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "kafka",
                "webhook",
                "websocket"
              ]
            },
            "kafka": {
              "properties": {
                "brokers": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "group_id": {
                  "type": "string"
                },
                "auto_offset_reset": {
                  "type": "string",
                  "enum": [
                    "earliest",
                    "latest"
                  ]
                },
                "topics": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "security_protocol": {
                  "type": "string",
                  "enum": [
                    "SASL_SSL",
                    "SSL",
                    "SASL_PLAINTEXT",
                    "PLAINTEXT"
                  ]
                },
                "ssl": {
                  "properties": {
                    "ca_location": {
                      "type": "string"
                    },
                    "certificate_location": {
                      "type": "string"
                    },
                    "key_location": {
                      "type": "string"
                    },
                    "key_password": {
                      "type": "string"
                    },
                    "endpoint_identification_algorithm": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object"
                },
                "sasl": {
                  "properties": {
                    "mechanism": {
                      "type": "string",
                      "enum": [
                        "PLAIN",
                        "SCRAM-SHA-256",
                        "SCRAM-SHA-512",
                        "GSSAPI"
                      ]
                    },
                    "username": {
                      "type": "string"
                    },
                    "password": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "mechanism",
                    "username",
                    "password"
                  ]
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "brokers",
                "group_id",
                "auto_offset_reset",
                "topics"
              ]
            },
            "websocket": {
              "properties": {
                "uri": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "uri"
              ]
            },
            "webhook": {
              "properties": {
                "signature_type": {
                  "type": "string",
                  "enum": [
                    "hmac"
                  ]
                },
                "hmac": {
                  "properties": {
                    "header": {
                      "type": "string"
                    },
                    "sig_key": {
                      "type": "string"
                    },
                    "secret": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "header",
                    "sig_key",
                    "secret"
                  ]
                }
              },
              "additionalProperties": false,
              "type": "object"
            },
            "error": {
              "properties": {
                "policy": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "policy"
              ]
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "type"
          ],
          "description": "Configuration for the data source."
        },
        "handler": {
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "handlers.InferredDiskBatch",
                "handlers.InferredMemBatch",
                "handlers.StructuredBatch"
              ]
            },
            "sql": {
              "type": "string"
            },
            "sql_results_cache_dir": {
              "type": "string"
            },
            "table": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "type",
            "sql"
          ]
        },
        "sink": {
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "clickhouse",
                "console",
                "iceberg",
                "kafka",
                "noop",
                "sqlcommand"
              ],
              "description": "Sink identifier."
            },
            "format": {
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "parquet"
                  ]
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "type"
              ],
              "description": "Format settings (e.g., for Parquet)."
            },
            "kafka": {
              "properties": {
                "brokers": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "description": "List of Kafka brokers."
                },
                "topic": {
                  "type": "string",
                  "description": "Target Kafka topic."
                },
                "security_protocol": {
                  "type": "string"
                },
                "ssl": {
                  "properties": {
                    "ca_location": {
                      "type": "string"
                    },
                    "certificate_location": {
                      "type": "string"
                    },
                    "key_location": {
                      "type": "string"
                    },
                    "key_password": {
                      "type": "string"
                    },
                    "endpoint_identification_algorithm": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object"
                },
                "sasl": {
                  "properties": {
                    "mechanism": {
                      "type": "string",
                      "enum": [
                        "PLAIN",
                        "SCRAM-SHA-256",
                        "SCRAM-SHA-512",
                        "GSSAPI"
                      ]
                    },
                    "username": {
                      "type": "string"
                    },
                    "password": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "mechanism",
                    "username",
                    "password"
                  ]
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "brokers",
                "topic"
              ],
              "description": "Kafka-specific sink configuration."
            },
            "console": {
              "properties": {},
              "additionalProperties": false,
              "type": "object",
              "description": "Console output sink configuration."
            },
            "sqlcommand": {
              "properties": {
                "sql": {
                  "type": "string"
                },
                "substitutions": {
                  "items": {
                    "properties": {
                      "var": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "uuid4"
                        ]
                      }
                    },
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "var",
                      "type"
                    ]
                  },
                  "type": "array"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "sql"
              ],
              "description": "SQL-command sink configuration."
            },
            "iceberg": {
              "properties": {
                "catalog_name": {
                  "type": "string"
                },
                "table_name": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "catalog_name",
                "table_name"
              ],
              "description": "Iceberg-specific sink configuration."
            },
            "clickhouse": {
              "properties": {
                "dsn": {
                  "type": "string"
                },
                "table": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "dsn",
                "table"
              ],
              "description": "ClickHouse-specific sink configuration."
            },
            "retry": {
              "properties": {
                "max_attempts": {
                  "type": "integer",
                  "description": "Total attempts, including the first. 1 disables retrying."
                },
                "initial_backoff_ms": {
                  "type": "integer",
                  "description": "Wait before the first retry. Doubles each attempt."
                },
                "max_backoff_ms": {
                  "type": "integer",
                  "description": "Ceiling on the backoff."
                },
                "deadline_seconds": {
                  "type": "integer",
                  "description": "Bounds the whole ladder, not one attempt. Keep it below\npipeline.flush_interval_seconds: the retry runs inside the open state\ntransaction, whose clock the window depends on."
                }
              },
              "additionalProperties": false,
              "type": "object",
              "description": "Bounds how long this sink keeps trying a destination that is not\nanswering. Omit to accept the defaults; set max_attempts to 1 to turn\nretrying off. The kafka sink ignores this: franz-go already retries a\nproduce with its own backoff."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "type"
          ]
        },
        "batch_size": {
          "type": "integer",
          "description": "Messages accumulated before the handler runs. Larger batches trade\nlatency for throughput."
        },
        "flush_interval_seconds": {
          "type": "integer",
          "description": "Longest a partial batch waits before it is invoked anyway."
        },
        "state": {
          "properties": {
            "path": {
              "type": "string",
              "description": "File backing the pipeline's DuckDB database. Window state and Kafka\noffsets are stored here and committed together."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "path"
          ],
          "description": "Where the pipeline keeps its DuckDB state. Absent means in-memory, and\nstate is lost on a crash."
        },
        "on_error": {
          "properties": {
            "policy": {
              "type": "string",
              "enum": [
                "RAISE",
                "IGNORE",
                "DLQ"
              ],
              "description": "Defines how errors should be handled."
            },
            "dlq": {
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "clickhouse",
                    "console",
                    "iceberg",
                    "kafka",
                    "noop",
                    "sqlcommand"
                  ],
                  "description": "Sink identifier."
                },
                "format": {
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "parquet"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "description": "Format settings (e.g., for Parquet)."
                },
                "kafka": {
                  "properties": {
                    "brokers": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array",
                      "description": "List of Kafka brokers."
                    },
                    "topic": {
                      "type": "string",
                      "description": "Target Kafka topic."
                    },
                    "security_protocol": {
                      "type": "string"
                    },
                    "ssl": {
                      "properties": {
                        "ca_location": {
                          "type": "string"
                        },
                        "certificate_location": {
                          "type": "string"
                        },
                        "key_location": {
                          "type": "string"
                        },
                        "key_password": {
                          "type": "string"
                        },
                        "endpoint_identification_algorithm": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false,
                      "type": "object"
                    },
                    "sasl": {
                      "properties": {
                        "mechanism": {
                          "type": "string",
                          "enum": [
                            "PLAIN",
                            "SCRAM-SHA-256",
                            "SCRAM-SHA-512",
                            "GSSAPI"
                          ]
                        },
                        "username": {
                          "type": "string"
                        },
                        "password": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "mechanism",
                        "username",
                        "password"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "brokers",
                    "topic"
                  ],
                  "description": "Kafka-specific sink configuration."
                },
                "console": {
                  "properties": {},
                  "additionalProperties": false,
                  "type": "object",
                  "description": "Console output sink configuration."
                },
                "sqlcommand": {
                  "properties": {
                    "sql": {
                      "type": "string"
                    },
                    "substitutions": {
                      "items": {
                        "properties": {
                          "var": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "uuid4"
                            ]
                          }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "var",
                          "type"
                        ]
                      },
                      "type": "array"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "sql"
                  ],
                  "description": "SQL-command sink configuration."
                },
                "iceberg": {
                  "properties": {
                    "catalog_name": {
                      "type": "string"
                    },
                    "table_name": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "catalog_name",
                    "table_name"
                  ],
                  "description": "Iceberg-specific sink configuration."
                },
                "clickhouse": {
                  "properties": {
                    "dsn": {
                      "type": "string"
                    },
                    "table": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "dsn",
                    "table"
                  ],
                  "description": "ClickHouse-specific sink configuration."
                },
                "retry": {
                  "properties": {
                    "max_attempts": {
                      "type": "integer",
                      "description": "Total attempts, including the first. 1 disables retrying."
                    },
                    "initial_backoff_ms": {
                      "type": "integer",
                      "description": "Wait before the first retry. Doubles each attempt."
                    },
                    "max_backoff_ms": {
                      "type": "integer",
                      "description": "Ceiling on the backoff."
                    },
                    "deadline_seconds": {
                      "type": "integer",
                      "description": "Bounds the whole ladder, not one attempt. Keep it below\npipeline.flush_interval_seconds: the retry runs inside the open state\ntransaction, whose clock the window depends on."
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "description": "Bounds how long this sink keeps trying a destination that is not\nanswering. Omit to accept the defaults; set max_attempts to 1 to turn\nretrying off. The kafka sink ignores this: franz-go already retries a\nproduce with its own backoff."
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "type"
              ],
              "description": "Dead-letter queue configuration. Failed messages will be routed to this\nsink."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "policy"
          ],
          "description": "Global error handling strategy for the pipeline."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "source",
        "handler",
        "sink"
      ],
      "description": "Main pipeline configuration."
    },
    "tables": {
      "properties": {
        "sql": {
          "items": {
            "properties": {
              "name": {
                "type": "string"
              },
              "sql": {
                "type": "string"
              },
              "manager": {
                "properties": {
                  "tumbling_window": {
                    "properties": {
                      "collect_closed_windows_sql": {
                        "type": "string"
                      },
                      "delete_closed_windows_sql": {
                        "type": "string"
                      },
                      "poll_interval_seconds": {
                        "type": "integer",
                        "description": "How often to collect closed windows. Optional; the manager applies its\nown default when this is absent or not positive."
                      }
                    },
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "collect_closed_windows_sql",
                      "delete_closed_windows_sql"
                    ]
                  },
                  "sink": {
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "clickhouse",
                          "console",
                          "iceberg",
                          "kafka",
                          "noop",
                          "sqlcommand"
                        ],
                        "description": "Sink identifier."
                      },
                      "format": {
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "parquet"
                            ]
                          }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "type"
                        ],
                        "description": "Format settings (e.g., for Parquet)."
                      },
                      "kafka": {
                        "properties": {
                          "brokers": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array",
                            "description": "List of Kafka brokers."
                          },
                          "topic": {
                            "type": "string",
                            "description": "Target Kafka topic."
                          },
                          "security_protocol": {
                            "type": "string"
                          },
                          "ssl": {
                            "properties": {
                              "ca_location": {
                                "type": "string"
                              },
                              "certificate_location": {
                                "type": "string"
                              },
                              "key_location": {
                                "type": "string"
                              },
                              "key_password": {
                                "type": "string"
                              },
                              "endpoint_identification_algorithm": {
                                "type": "string"
                              }
                            },
                            "additionalProperties": false,
                            "type": "object"
                          },
                          "sasl": {
                            "properties": {
                              "mechanism": {
                                "type": "string",
                                "enum": [
                                  "PLAIN",
                                  "SCRAM-SHA-256",
                                  "SCRAM-SHA-512",
                                  "GSSAPI"
                                ]
                              },
                              "username": {
                                "type": "string"
                              },
                              "password": {
                                "type": "string"
                              }
                            },
                            "additionalProperties": false,
                            "type": "object",
                            "required": [
                              "mechanism",
                              "username",
                              "password"
                            ]
                          }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "brokers",
                          "topic"
                        ],
                        "description": "Kafka-specific sink configuration."
                      },
                      "console": {
                        "properties": {},
                        "additionalProperties": false,
                        "type": "object",
                        "description": "Console output sink configuration."
                      },
                      "sqlcommand": {
                        "properties": {
                          "sql": {
                            "type": "string"
                          },
                          "substitutions": {
                            "items": {
                              "properties": {
                                "var": {
                                  "type": "string"
                                },
                                "type": {
                                  "type": "string",
                                  "enum": [
                                    "uuid4"
                                  ]
                                }
                              },
                              "additionalProperties": false,
                              "type": "object",
                              "required": [
                                "var",
                                "type"
                              ]
                            },
                            "type": "array"
                          }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "sql"
                        ],
                        "description": "SQL-command sink configuration."
                      },
                      "iceberg": {
                        "properties": {
                          "catalog_name": {
                            "type": "string"
                          },
                          "table_name": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "catalog_name",
                          "table_name"
                        ],
                        "description": "Iceberg-specific sink configuration."
                      },
                      "clickhouse": {
                        "properties": {
                          "dsn": {
                            "type": "string"
                          },
                          "table": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "dsn",
                          "table"
                        ],
                        "description": "ClickHouse-specific sink configuration."
                      },
                      "retry": {
                        "properties": {
                          "max_attempts": {
                            "type": "integer",
                            "description": "Total attempts, including the first. 1 disables retrying."
                          },
                          "initial_backoff_ms": {
                            "type": "integer",
                            "description": "Wait before the first retry. Doubles each attempt."
                          },
                          "max_backoff_ms": {
                            "type": "integer",
                            "description": "Ceiling on the backoff."
                          },
                          "deadline_seconds": {
                            "type": "integer",
                            "description": "Bounds the whole ladder, not one attempt. Keep it below\npipeline.flush_interval_seconds: the retry runs inside the open state\ntransaction, whose clock the window depends on."
                          }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "description": "Bounds how long this sink keeps trying a destination that is not\nanswering. Omit to accept the defaults; set max_attempts to 1 to turn\nretrying off. The kafka sink ignores this: franz-go already retries a\nproduce with its own backoff."
                      }
                    },
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "type"
                    ]
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "tumbling_window",
                  "sink"
                ]
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "sql"
            ],
            "description": "SQL Tables"
          },
          "type": "array",
          "description": "List of tables with their SQL definitions and management configurations."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "sql"
      ],
      "description": "Predefined SQL tables used in the pipeline."
    },
    "udfs": {
      "items": {
        "properties": {
          "function_name": {
            "type": "string"
          },
          "import_path": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "function_name",
          "import_path"
        ],
        "description": "UDF registers a user-defined function the handler SQL can call."
      },
      "type": "array",
      "description": "List of User-Defined Functions (UDFs) to be used in SQL queries."
    },
    "commands": {
      "items": {
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the command for reference."
          },
          "sql": {
            "type": "string",
            "description": "SQL statements to execute."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "sql"
        ],
        "description": "SQLCommand is one statement run at startup, before any table is created."
      },
      "type": "array",
      "description": "List of SQL commands to execute before processing the pipeline."
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "pipeline"
  ],
  "description": "Conf is a whole pipeline file."
}
