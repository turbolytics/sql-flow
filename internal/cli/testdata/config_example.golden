# Main pipeline configuration.
pipeline:
  # Name of the pipeline.
  name: <string>
  # Description of the pipeline.
  description: <string>
  # Configuration for the data source.
  source:
    type: kafka | mqtt | webhook | websocket
    kafka:
      brokers:
        - <array>
      group_id: <string>
      auto_offset_reset: earliest | latest
      topics:
        - <array>
      security_protocol: SASL_SSL | SSL | SASL_PLAINTEXT | PLAINTEXT
      ssl:
        ca_location: <string>
        certificate_location: <string>
        key_location: <string>
        key_password: <string>
        endpoint_identification_algorithm: <string>
      sasl:
        mechanism: PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512 | GSSAPI
        username: <string>
        password: <string>
      # Bounds how far the consumer reads ahead of the pipeline. Omit the
      # block to accept the defaults, which bound a backlog replay to a few
      # fetches rather than the backlog.
      fetch:
        # Bytes one fetch may return per broker. Kafka's fetch.max.bytes.
        max_bytes: <integer>
        # Bytes one fetch may return per partition. Kafka's max.partition.fetch.bytes.
        max_partition_bytes: <integer>
        # Fetches held ahead of the pipeline.
        prefetch: <integer>
    websocket:
      uri: <string>
      # EventTime names the field of each frame that carries the event's own
      # time. Absent, the event time is arrival: the moment the frame reached
      # this process, which says nothing about when the event happened and
      # reads as caught up exactly when a server replaying history is furthest
      # behind. Set it, and the record's time is the record's. On a windowing
      # pipeline a frame without a usable value at the path is refused.
      event_time:
        # Path into the JSON frame, dotted for nesting: "time_us", or
        # "commit.record.createdAt".
        path: <string>
        # Format is the value's encoding. The unix_* forms take an integer,
        # or a string holding one; rfc3339 takes a string.
        format: unix_s | unix_ms | unix_us | unix_ns | rfc3339
    webhook:
      # The address the listener binds, as host:port. Defaults to
      # 0.0.0.0:8001. A platform that assigns the port sets it from the
      # environment: "0.0.0.0:{{ PORT }}".
      addr: <string>
      signature_type: hmac
      hmac:
        header: <string>
        sig_key: <string>
        secret: <string>
      # Bytes one request body may carry. A larger body is refused with 413
      # before it is read or its signature checked.
      max_body_bytes: <integer>
      # Open connections the listener holds. Past it a new connection waits
      # in the backlog until one closes.
      max_connections: <integer>
    mqtt:
      # The broker URL, tcp:// or mqtt://. TLS is not supported yet.
      broker: <string>
      # Fixed across restarts. The broker keys the session by it, so a new ID
      # starts an empty session and abandons the old one's publishes.
      client_id: <string>
      # Topic filters, subscribed at QoS 1. Wildcards + and # are allowed.
      topics:
        - <array>
      # How long the broker keeps the session after a disconnect. Defaults to
      # 3600.
      session_expiry_seconds: <integer>
      # Unacknowledged publishes the broker may send. Must be at least
      # pipeline.batch_size. Defaults to 65535.
      receive_maximum: <integer>
    error:
      policy: <string>
  handler:
    type: handlers.InferredDiskBatch | handlers.InferredMemBatch | handlers.StructuredBatch
    sql: <string>
    sql_results_cache_dir: <string>
    table: <string>
  sink:
    # Sink identifier.
    type: clickhouse | console | iceberg | kafka | noop | postgres | sqlcommand
    # Format settings (e.g., for Parquet).
    format:
      type: parquet
    # Kafka-specific sink configuration.
    kafka:
      # List of Kafka brokers.
      brokers:
        - <array>
      # Target Kafka topic.
      topic: <string>
      security_protocol: <string>
      ssl:
        ca_location: <string>
        certificate_location: <string>
        key_location: <string>
        key_password: <string>
        endpoint_identification_algorithm: <string>
      sasl:
        mechanism: PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512 | GSSAPI
        username: <string>
        password: <string>
    # Console output sink configuration.
    console:
    # SQL-command sink configuration.
    sqlcommand:
      sql: <string>
      substitutions:
        -
          var: <string>
          type: uuid4
    # Iceberg-specific sink configuration.
    iceberg:
      catalog_name: <string>
      table_name: <string>
    # ClickHouse-specific sink configuration.
    clickhouse:
      dsn: <string>
      table: <string>
    # Postgres-specific sink configuration.
    postgres:
      # A libpq connection URI or key-value string. Connect directly, or through
      # a pooler in session mode: the staging table lives for the session, and
      # transaction pooling hands each transaction whichever server connection
      # is free.
      dsn: <string>
      # The target table, optionally schema-qualified. The sink never creates
      # it.
      table: <string>
      # upsert replaces the row a key already identifies; append inserts every
      # row. Required: the two are different promises to the reader.
      mode: upsert | append
      # The columns a row is identified by. Required for upsert, refused for
      # append. A unique index or constraint must cover exactly these columns.
      key:
        - <array>
    # Bounds how long this sink keeps trying a destination that is not
    # answering. Omit to accept the defaults; set max_attempts to 1 to turn
    # retrying off. The kafka sink ignores this: franz-go already retries a
    # produce with its own backoff.
    retry:
      # Total attempts, including the first. 1 disables retrying.
      max_attempts: <integer>
      # Wait before the first retry. Doubles each attempt.
      initial_backoff_ms: <integer>
      # Ceiling on the backoff.
      max_backoff_ms: <integer>
      # Bounds the whole ladder. The postgres sink also bounds each attempt by
      # it, so raise it for a batch whose write takes longer. Keep it below
      # pipeline.flush_interval_seconds: the retry runs inside the open state
      # transaction, whose clock the window depends on.
      deadline_seconds: <integer>
  # Messages accumulated before the handler runs. Larger batches trade
  # latency for throughput.
  batch_size: <integer>
  # Longest a partial batch waits before it is invoked anyway. Absent
  # means DefaultFlushIntervalSeconds. It also paces the idle tick, the
  # commit that confirms a quiet stream to a window's idle close.
  flush_interval_seconds: <integer>
  # Longest a shutdown may take after SIGTERM. The final batch, the
  # managers' final poll and the state syncs share it. Absent means 30.
  # When it passes the process exits 15, and the next start replays what
  # was not written.
  drain_deadline_seconds: <integer>
  # Where the pipeline keeps its DuckDB state. Absent means in-memory, and
  # state is lost on a crash.
  state:
    # File backing the pipeline's DuckDB database. Window state and Kafka
    # offsets are stored here and committed together.
    path: <string>
  # Global error handling strategy for the pipeline.
  on_error:
    # Defines how errors should be handled.
    policy: RAISE | IGNORE | DLQ
    # Dead-letter queue configuration. Failed messages will be routed to this
    # sink.
    dlq:
      # Sink identifier.
      type: clickhouse | console | iceberg | kafka | noop | postgres | sqlcommand
      # Format settings (e.g., for Parquet).
      format:
        type: parquet
      # Kafka-specific sink configuration.
      kafka:
        # List of Kafka brokers.
        brokers:
          - <array>
        # Target Kafka topic.
        topic: <string>
        security_protocol: <string>
        ssl:
          ca_location: <string>
          certificate_location: <string>
          key_location: <string>
          key_password: <string>
          endpoint_identification_algorithm: <string>
        sasl:
          mechanism: PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512 | GSSAPI
          username: <string>
          password: <string>
      # Console output sink configuration.
      console:
      # SQL-command sink configuration.
      sqlcommand:
        sql: <string>
        substitutions:
          -
            var: <string>
            type: uuid4
      # Iceberg-specific sink configuration.
      iceberg:
        catalog_name: <string>
        table_name: <string>
      # ClickHouse-specific sink configuration.
      clickhouse:
        dsn: <string>
        table: <string>
      # Postgres-specific sink configuration.
      postgres:
        # A libpq connection URI or key-value string. Connect directly, or through
        # a pooler in session mode: the staging table lives for the session, and
        # transaction pooling hands each transaction whichever server connection
        # is free.
        dsn: <string>
        # The target table, optionally schema-qualified. The sink never creates
        # it.
        table: <string>
        # upsert replaces the row a key already identifies; append inserts every
        # row. Required: the two are different promises to the reader.
        mode: upsert | append
        # The columns a row is identified by. Required for upsert, refused for
        # append. A unique index or constraint must cover exactly these columns.
        key:
          - <array>
      # Bounds how long this sink keeps trying a destination that is not
      # answering. Omit to accept the defaults; set max_attempts to 1 to turn
      # retrying off. The kafka sink ignores this: franz-go already retries a
      # produce with its own backoff.
      retry:
        # Total attempts, including the first. 1 disables retrying.
        max_attempts: <integer>
        # Wait before the first retry. Doubles each attempt.
        initial_backoff_ms: <integer>
        # Ceiling on the backoff.
        max_backoff_ms: <integer>
        # Bounds the whole ladder. The postgres sink also bounds each attempt by
        # it, so raise it for a batch whose write takes longer. Keep it below
        # pipeline.flush_interval_seconds: the retry runs inside the open state
        # transaction, whose clock the window depends on.
        deadline_seconds: <integer>
  # Where this instance reports itself. Absent means it reports nowhere,
  # which is the ordinary case for a pipeline with no control plane.
  turbostats:
    # ID is the operator's name for this instance. The receiver files a
    # bundle under it, so reporting without one cannot be filed at all.
    id: <string>
    # ReportTo is where bundles are posted. Empty means reporting is off,
    # which is the ordinary case for an instance with no control plane.
    report_to: <string>
    # Key is the credential the control plane issued. It is the private half
    # of an Ed25519 keypair and belongs in an environment variable, which the
    # template renders in.
    key: <string>
    # IntervalSeconds is how often to report. Absent means the default.
    interval_seconds: <integer>
    # Labels are the operator's own, copied into every report, so a fleet
    # can be filtered by region, tenant or environment.
    # At most 10. A key is lower case, starts with a letter, and is at most
    # 32 characters of [a-z0-9_]. A value is at most 64 characters. A key
    # the bundle already carries is refused: id, name, version, commit,
    # arch, config_hash, source_type, sink_type, handler_type.
    # They are fixed for the life of the process: a receiver stores a series
    # per field, and a set that changed mid-run would split one instance's
    # history in two.
    labels:
      <name>:
# Predefined SQL tables used in the pipeline.
tables:
  # List of tables with their SQL definitions and management configurations.
  sql:
    -
      name: <string>
      sql: <string>
      # A tumbling window over this table, closed by the engine.
      window:
        # The column holding each row's bucket start. TIMESTAMPTZ.
        time_column: <string>
        # The bucket length. A bucket ends at time_column + size.
        size_seconds: <integer>
        # How far past a bucket's end the stream's own clock must reach before
        # the bucket closes. Absent means 0.
        grace_seconds: <integer>
        # How long the stream may be quiet before every open bucket closes.
        # Absent means never: a stream that stops leaves its last bucket open.
        # The quiet is the engine's to confirm, by a commit that late, so the
        # close can trail this by up to one flush_interval_seconds; validate
        # warns when that interval is the longer of the two.
        idle_close_seconds: <integer>
        # What happens to a row for a bucket that already closed. drop discards
        # it and counts it. reemit publishes emit_sql over the late rows alone,
        # for a sink that adds them to the bucket it holds; a sink that replaces
        # the bucket's value loses the rows published before.
        # Required: the two are different promises to the sink.
        late_rows: drop | reemit
        # How often the engine looks for closed buckets. Absent means 10.
        poll_interval_seconds: <integer>
        # Shapes the closed rows before the sink. It reads one relation, closed,
        # which holds every row of every bucket that just closed. Absent means
        # SELECT * FROM closed.
        emit_sql: <string>
        # Where closed windows go.
        sink:
          # Sink identifier.
          type: clickhouse | console | iceberg | kafka | noop | postgres | sqlcommand
          # Format settings (e.g., for Parquet).
          format:
            type: parquet
          # Kafka-specific sink configuration.
          kafka:
            # List of Kafka brokers.
            brokers:
              - <array>
            # Target Kafka topic.
            topic: <string>
            security_protocol: <string>
            ssl:
              ca_location: <string>
              certificate_location: <string>
              key_location: <string>
              key_password: <string>
              endpoint_identification_algorithm: <string>
            sasl:
              mechanism: PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512 | GSSAPI
              username: <string>
              password: <string>
          # Console output sink configuration.
          console:
          # SQL-command sink configuration.
          sqlcommand:
            sql: <string>
            substitutions:
              -
                var: <string>
                type: uuid4
          # Iceberg-specific sink configuration.
          iceberg:
            catalog_name: <string>
            table_name: <string>
          # ClickHouse-specific sink configuration.
          clickhouse:
            dsn: <string>
            table: <string>
          # Postgres-specific sink configuration.
          postgres:
            # A libpq connection URI or key-value string. Connect directly, or through
            # a pooler in session mode: the staging table lives for the session, and
            # transaction pooling hands each transaction whichever server connection
            # is free.
            dsn: <string>
            # The target table, optionally schema-qualified. The sink never creates
            # it.
            table: <string>
            # upsert replaces the row a key already identifies; append inserts every
            # row. Required: the two are different promises to the reader.
            mode: upsert | append
            # The columns a row is identified by. Required for upsert, refused for
            # append. A unique index or constraint must cover exactly these columns.
            key:
              - <array>
          # Bounds how long this sink keeps trying a destination that is not
          # answering. Omit to accept the defaults; set max_attempts to 1 to turn
          # retrying off. The kafka sink ignores this: franz-go already retries a
          # produce with its own backoff.
          retry:
            # Total attempts, including the first. 1 disables retrying.
            max_attempts: <integer>
            # Wait before the first retry. Doubles each attempt.
            initial_backoff_ms: <integer>
            # Ceiling on the backoff.
            max_backoff_ms: <integer>
            # Bounds the whole ladder. The postgres sink also bounds each attempt by
            # it, so raise it for a batch whose write takes longer. Keep it below
            # pipeline.flush_interval_seconds: the retry runs inside the open state
            # transaction, whose clock the window depends on.
            deadline_seconds: <integer>
# List of User-Defined Functions (UDFs) to be used in SQL queries.
udfs:
  -
    function_name: <string>
    import_path: <string>
# List of SQL commands to execute before processing the pipeline.
commands:
  -
    # Name of the command for reference.
    name: <string>
    # SQL statements to execute.
    sql: <string>
